# ==============================================
# FASTLANE ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git (add to .gitignore)

# ==============================================
# APPLE DEVELOPER PORTAL
# ==============================================
# Your Apple ID email (used for Apple Developer Portal)
APPLE_ID=your-apple-id@example.com

# App-specific password for your Apple ID
# Generate at: https://appleid.apple.com/account/manage -> Sign-In and Security -> App-Specific Passwords
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your Team ID (10 characters)
# Find at: https://developer.apple.com/account -> Membership -> Team ID
TEAM_ID=XXXXXXXXXX

# Alternative: Team Name (if you prefer using name instead of ID)
# TEAM_NAME="Your Company Name"

# ==============================================
# APP STORE CONNECT
# ==============================================
# App Store Connect Team ID (can be different from Developer Portal Team ID)
# Find at: https://appstoreconnect.apple.com -> Users and Access -> Keys -> Issuer ID
ITC_TEAM_ID=123456789

# ==============================================
# APP INFORMATION
# ==============================================
# Your app's bundle identifier
APP_IDENTIFIER=com.yourcompany.hola

# App name as it appears in App Store
APP_NAME=Hola

# App Store URL (optional, for convenience)
# APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX

# ==============================================
# BUILD CONFIGURATION
# ==============================================
# Build configuration (Debug, Release)
CONFIGURATION=Release

# Export method for builds
# Options: app-store, ad-hoc, development, enterprise
EXPORT_METHOD=app-store

# Xcode scheme name
SCHEME=hola

# Workspace file name
WORKSPACE=hola.xcworkspace

# Project file name
PROJECT=hola.xcodeproj

# ==============================================
# CODE SIGNING (MATCH)
# ==============================================
# Git repository URL for storing certificates (private repo recommended)
MATCH_GIT_URL=https://github.com/your-username/certificates-repo

# Password for encrypting/decrypting certificates
MATCH_PASSWORD=your-super-secure-password

# Git branch for match (optional, defaults to master)
# MATCH_GIT_BRANCH=main

# ==============================================
# NOTIFICATIONS (OPTIONAL)
# ==============================================
# Slack webhook URL for build notifications
# SLACK_URL=slack_url

# Slack channel for notifications
# SLACK_CHANNEL=#ios-builds

# Discord webhook URL (alternative to Slack)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# ==============================================
# CI/CD SPECIFIC
# ==============================================
# Set to true when running in CI environment
# CI=true

# GitHub token for accessing private repositories (if needed)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ==============================================
# TESTING
# ==============================================
# Device for running tests
TEST_DEVICE=iPhone 15

# iOS version for testing
# IOS_VERSION=17.0

# ==============================================
# ADVANCED SETTINGS
# ==============================================
# Skip waiting for build processing in TestFlight
SKIP_WAITING_FOR_BUILD_PROCESSING=true

# Force upload even if warnings exist
FORCE_UPLOAD=false

# Automatically increment build number
AUTO_INCREMENT_BUILD=true

# Clear derived data before building
CLEAR_DERIVED_DATA=false

# ==============================================
# PILOT (TESTFLIGHT) SETTINGS
# ==============================================
# Skip submission for review
PILOT_SKIP_SUBMISSION=true

# Distribute to external testers
# PILOT_DISTRIBUTE_EXTERNAL=false

# Groups to distribute to
# PILOT_GROUPS=Beta Testers,Internal Team

# ==============================================
# DELIVER (APP STORE) SETTINGS
# ==============================================
# Skip metadata upload
# DELIVER_SKIP_METADATA=false

# Skip screenshots upload
# DELIVER_SKIP_SCREENSHOTS=false

# Submit for review automatically
# DELIVER_SUBMIT_FOR_REVIEW=false

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================
# Development team ID (might be different from distribution team)
# DEV_TEAM_ID=XXXXXXXXXX

# Development provisioning profile
# DEV_PROVISIONING_PROFILE=match Development com.yourcompany.hola