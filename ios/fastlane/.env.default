# Environment variables for Fastlane
# Copy this file to .env and fill in your actual values

# Apple Developer Portal
APPLE_ID=your-apple-id@email.com
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=your-app-specific-password
TEAM_ID=XXXXXXXXXX

# App Store Connect
ITC_TEAM_ID=123456789

# Match (code signing)
MATCH_PASSWORD=your-match-password
MATCH_GIT_URL=https://github.com/your-username/certificates

# Slack (optional)
SLACK_URL=https://hooks.slack.com/services/your/slack/webhook

# App Info
APP_IDENTIFIER=com.yourcompany.hola
APP_NAME=Hola

# Build settings
CONFIGURATION=Release
EXPORT_METHOD=app-store